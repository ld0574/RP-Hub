# RP-Hub 后端环境变量示例
# PostgreSQL 连接地址（生产建议强密码和独立账户）
DATABASE_URL=postgresql+psycopg2://rphub:rphub@127.0.0.1:5432/rphub

# Qdrant 服务地址
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rp_hub_memories
EMBEDDING_DIM=1536

# 跨域来源，逗号分隔；* 表示全部允许（开发环境）
CORS_ORIGINS=*

# 运行环境标签
APP_ENV=development
